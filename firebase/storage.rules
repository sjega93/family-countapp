rules_version = '2';

// Ordner
//   families/{familyId}/eingang/{datei}   Originale, von Hand über die Konsole hochgeladen
//   families/{familyId}/photos/{id}.webp  fertig zugeschnittene Fotos (512 × 512, WebP)
//   families/{familyId}/voice/{key}.m4a   Sprachaufnahmen (AAC)
//
// Uploads über die Konsole umgehen diese Regeln; die App darf nur die fertigen Formate schreiben.
// Cache-Control: no-store setzt die App beim Hochladen (in Regeln nicht prüfbar).

service firebase.storage {
  match /b/{bucket}/o {

    function isMember(familyId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/families/$(familyId)).data.members;
    }

    match /families/{familyId}/eingang/{file} {
      allow read, delete: if isMember(familyId);
      allow write: if false;
    }

    match /families/{familyId}/photos/{file} {
      allow read, delete: if isMember(familyId);
      allow create, update: if isMember(familyId)
        && file.matches('^[A-Za-z0-9_-]+\\.webp$')
        && request.resource.contentType == 'image/webp'
        && request.resource.size < 300 * 1024;
    }

    match /families/{familyId}/voice/{file} {
      allow read, delete: if isMember(familyId);
      allow create, update: if isMember(familyId)
        && file.matches('^[A-Za-z0-9_-]+\\.m4a$')
        && request.resource.contentType in ['audio/mp4', 'audio/aac']
        && request.resource.size < 300 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
